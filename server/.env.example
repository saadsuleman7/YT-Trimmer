PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/yt-trimmer
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRE=7d
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_WEEKLY_PRICE_ID=price_weekly_id
STRIPE_MONTHLY_PRICE_ID=price_monthly_id
CLIENT_URL=http://localhost:3000
DISCORD_INVITE_URL=https://discord.gg/your-server
ADMIN_SETUP_KEY=131S@@d660!
OWNER_SETUP_KEY=131S@@d660!

# PayPal automatic payments
# Sign up at https://developer.paypal.com → My Apps → create REST API app
# Then go to Webhooks → add endpoint at https://YOUR-BACKEND-URL/api/payments/paypal/webhook → subscribe to PAYMENT.CAPTURE.COMPLETED
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret
PAYPAL_WEBHOOK_ID=your_paypal_webhook_id
PAYPAL_MODE=sandbox

# Email (optional — skip to disable email notifications)
# Gmail: enable 2-Step Verification, then create an App Password at myaccount.google.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx
SMTP_FROM="YT-Trimmer <your-email@gmail.com>"
